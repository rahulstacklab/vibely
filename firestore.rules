rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn() && request.auth.uid in get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data.participants;
    }

    function isGroupAdmin(chatId) {
      return signedIn()
        && get(/databases/$(database)/documents/chats/$(chatId)).data.isGroup == true
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.groupAdmins;
    }

    function canonicalFriendshipId(firstUserId, secondUserId) {
      return firstUserId < secondUserId
        ? firstUserId + '__' + secondUserId
        : secondUserId + '__' + firstUserId;
    }

    function areFriends(firstUserId, secondUserId) {
      return signedIn()
        && exists(/databases/$(database)/documents/friendships/$(canonicalFriendshipId(firstUserId, secondUserId)));
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.senderId
          || request.auth.uid == resource.data.recipientId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'senderId', 'recipientId', 'status', 'createdAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && requestId == request.resource.data.senderId + '__' + request.resource.data.recipientId
        && !exists(/databases/$(database)/documents/friendships/$(canonicalFriendshipId(
          request.resource.data.senderId, request.resource.data.recipientId
        )));
      allow update: if signedIn()
        && (
          (
            request.auth.uid == resource.data.recipientId
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['accepted', 'rejected']
          )
          || (
            request.auth.uid == resource.data.senderId
            && resource.data.status in ['accepted', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'createdAt'])
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time
            && !exists(/databases/$(database)/documents/friendships/$(canonicalFriendshipId(
              resource.data.senderId, resource.data.recipientId
            )))
          )
        );
      allow delete: if signedIn()
        && request.auth.uid == resource.data.senderId
        && resource.data.status == 'pending';
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'requestId', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members.toSet().size() == 2
        && request.auth.uid in request.resource.data.members
        && friendshipId == canonicalFriendshipId(request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId in request.resource.data.members
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.recipientId in request.resource.data.members;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.userId
          || areFriends(request.auth.uid, resource.data.userId));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'image', 'caption', 'vibe', 'createdAt', 'likedBy', 'viewedBy'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 700000
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 1000
        && request.resource.data.vibe is string
        && request.resource.data.vibe.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.likedBy == []
        && request.resource.data.viewedBy == [];
      allow update: if signedIn()
        && (request.auth.uid == resource.data.userId || areFriends(request.auth.uid, resource.data.userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'viewedBy'])
        && request.resource.data.likedBy is list
        && request.resource.data.viewedBy is list
        && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
        && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
        && request.resource.data.viewedBy.toSet().difference(resource.data.viewedBy.toSet()).hasOnly([request.auth.uid])
        && resource.data.viewedBy.toSet().difference(request.resource.data.viewedBy.toSet()).hasOnly([]);
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'username', 'avatar', 'vibe', 'bio', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.username is string
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'username', 'avatar', 'vibe', 'bio'
        ]);
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.keys().hasOnly([
              'participants', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.participants.size() == 2
          )
          || (
            request.resource.data.keys().hasOnly([
              'participants', 'groupAdmins', 'ownerId', 'isGroup', 'groupName',
              'inviteCode', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.isGroup == true
            && request.resource.data.participants.size() == 1
            && request.resource.data.groupAdmins == [request.auth.uid]
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.groupName is string
            && request.resource.data.groupName.size() >= 2
            && request.resource.data.groupName.size() <= 60
            && request.resource.data.inviteCode is string
            && getAfter(
              /databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)
            ).data.chatId == chatId
            && getAfter(
              /databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)
            ).data.createdBy == request.auth.uid
          )
        );
      allow update: if signedIn()
        && (
          request.auth.uid in resource.data.participants
          || (
            resource.data.isGroup == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
            && request.resource.data.participants is list
            && request.resource.data.participants.toSet().difference(
              resource.data.participants.toSet()
            ).hasOnly([request.auth.uid])
            && resource.data.inviteCode is string
            && exists(
              /databases/$(database)/documents/groupInvites/$(resource.data.inviteCode)
            )
            && get(
              /databases/$(database)/documents/groupInvites/$(resource.data.inviteCode)
            ).data.chatId == chatId
            && existsAfter(
              /databases/$(database)/documents/groupInvites/$(resource.data.inviteCode)/joins/$(request.auth.uid)
            )
            && getAfter(
              /databases/$(database)/documents/groupInvites/$(resource.data.inviteCode)/joins/$(request.auth.uid)
            ).data.chatId == chatId
          )
        )
        && (
          (
            resource.data.get('isGroup', false) != true
            && request.resource.data.participants == resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage', 'updatedAt', 'hiddenFor'
            ])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'lastMessage', 'updatedAt'
              ])
              || (
                request.resource.data.updatedAt == request.time
                && request.resource.data.lastMessage is string
                && request.resource.data.lastMessage.size() <= 4000
              )
            )
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hiddenFor'])
              || (
                request.resource.data.hiddenFor is list
                && request.resource.data.hiddenFor.hasOnly(resource.data.participants)
                && request.resource.data.hiddenFor.toSet().difference(
                  resource.data.get('hiddenFor', []).toSet()
                ).hasOnly([request.auth.uid])
                && resource.data.get('hiddenFor', []).toSet().difference(
                  request.resource.data.hiddenFor.toSet()
                ).hasOnly([request.auth.uid])
              )
            )
          )
          || (
            resource.data.isGroup == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage', 'updatedAt'
            ])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 4000
          )
          || (
            resource.data.isGroup == true
            && !(request.auth.uid in resource.data.participants)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
            && request.resource.data.participants is list
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.participants.toSet().difference(
              resource.data.participants.toSet()
            ).hasOnly([request.auth.uid])
            && request.resource.data.participants.hasAll(resource.data.participants)
            && resource.data.inviteCode is string
            && exists(
              /databases/$(database)/documents/groupInvites/$(resource.data.inviteCode)
            )
            && get(
              /databases/$(database)/documents/groupInvites/$(resource.data.inviteCode)
            ).data.chatId == chatId
          )
          || (
            isGroupAdmin(chatId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'groupName', 'updatedAt'
            ])
            && request.resource.data.groupName is string
            && request.resource.data.groupName.size() >= 2
            && request.resource.data.groupName.size() <= 60
            && request.resource.data.updatedAt == request.time
          )
          || (
            isGroupAdmin(chatId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCode'])
            && request.resource.data.inviteCode is string
            && getAfter(
              /databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)
            ).data.chatId == chatId
            && getAfter(
              /databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)
            ).data.createdBy == request.auth.uid
          )
          || (
            isGroupAdmin(chatId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'participants', 'groupAdmins'
            ])
            && request.resource.data.participants is list
            && request.resource.data.participants.size() >= 1
            && request.resource.data.groupAdmins is list
            && request.resource.data.groupAdmins.size() >= 1
            && request.resource.data.participants.hasAll(request.resource.data.groupAdmins)
            && request.resource.data.participants.toSet().size()
              == request.resource.data.participants.size()
            && request.resource.data.groupAdmins.toSet().size()
              == request.resource.data.groupAdmins.size()
            && resource.data.ownerId in request.resource.data.participants
            && resource.data.ownerId in request.resource.data.groupAdmins
            && request.auth.uid in request.resource.data.groupAdmins
          )
          || (
            resource.data.isGroup == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'participants', 'groupAdmins', 'ownerId'
            ])
            && request.resource.data.participants is list
            && request.resource.data.participants.size() >= 1
            && request.resource.data.groupAdmins is list
            && request.resource.data.groupAdmins.size() >= 1
            && request.resource.data.groupAdmins.hasOnly(request.resource.data.participants)
            && resource.data.participants.toSet().difference(
              request.resource.data.participants.toSet()
            ).hasOnly([request.auth.uid])
            && request.auth.uid in resource.data.participants.toSet().difference(
              request.resource.data.participants.toSet()
            )
            && (
              (
                !(request.auth.uid in resource.data.groupAdmins)
                && request.resource.data.groupAdmins == resource.data.groupAdmins
                && request.resource.data.ownerId == resource.data.ownerId
              )
              || (
                request.auth.uid in resource.data.groupAdmins
                && request.auth.uid in resource.data.groupAdmins.toSet().difference(
                  request.resource.data.groupAdmins.toSet()
                )
                && request.resource.data.ownerId in request.resource.data.groupAdmins
                && (
                  resource.data.ownerId == request.auth.uid
                  || request.resource.data.ownerId == resource.data.ownerId
                )
              )
            )
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'type', 'createdAt',
              'attachmentUrl', 'cloudinaryPublicId', 'cloudinaryResourceType',
              'fileName', 'mimeType', 'fileSize', 'duration', 'forwardedFrom', 'readBy'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.readBy is list
          && request.resource.data.readBy.size() == 1
          && request.auth.uid in request.resource.data.readBy
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && (
            !request.resource.data.keys().hasAny(['forwardedFrom'])
            || (
              request.resource.data.forwardedFrom is string
              && request.resource.data.forwardedFrom.size() <= 120
            )
          )
          && request.resource.data.createdAt == request.time
          && (
            request.resource.data.type == 'text'
            && request.resource.data.keys().hasOnly([
              'senderId', 'text', 'type', 'createdAt', 'forwardedFrom', 'readBy'
            ])
            ||
            request.resource.data.type in ['image', 'video', 'document', 'voice']
            && request.resource.data.keys().hasAll([
              'attachmentUrl', 'cloudinaryPublicId', 'cloudinaryResourceType',
              'fileName', 'mimeType', 'fileSize'
            ])
            && request.resource.data.attachmentUrl is string
            && request.resource.data.attachmentUrl.matches('https://res.cloudinary.com/.*')
            && request.resource.data.cloudinaryPublicId is string
            && request.resource.data.cloudinaryResourceType in ['image', 'video', 'raw']
            && request.resource.data.fileName is string
            && request.resource.data.mimeType is string
            && request.resource.data.fileSize is int
            && request.resource.data.fileSize > 0
            && request.resource.data.fileSize <= 52428800
            && (
              request.resource.data.type == 'image'
              && request.resource.data.cloudinaryResourceType == 'image'
              && request.resource.data.mimeType.matches('image/.*')
              ||
              request.resource.data.type == 'video'
              && request.resource.data.cloudinaryResourceType == 'video'
              && request.resource.data.mimeType.matches('video/.*')
              ||
              request.resource.data.type == 'voice'
              && request.resource.data.cloudinaryResourceType == 'video'
              && request.resource.data.mimeType.matches('audio/.*')
              && request.resource.data.duration is int
              ||
              request.resource.data.type == 'document'
              && request.resource.data.cloudinaryResourceType in ['image', 'raw']
              && request.resource.data.mimeType in [
                'application/pdf',
                'application/msword',
                'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                'application/vnd.ms-excel',
                'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                'application/vnd.ms-powerpoint',
                'application/vnd.openxmlformats-officedocument.presentationml.presentation',
                'application/vnd.oasis.opendocument.text',
                'application/rtf',
                'text/rtf',
                'text/plain'
              ]
            )
          );
        allow update: if isChatMember(chatId)
          && (
            (
              resource.data.senderId == request.auth.uid
              && resource.data.type == 'text'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text', 'editedAt'
              ])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000
              && request.resource.data.editedAt == request.time
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
              && request.resource.data.hiddenFor is list
              && request.resource.data.hiddenFor.hasOnly(resource.data.participants)
              && request.resource.data.hiddenFor.toSet().difference(
                resource.data.get('hiddenFor', []).toSet()
              ).hasOnly([request.auth.uid])
              && resource.data.get('hiddenFor', []).toSet().difference(
                request.resource.data.hiddenFor.toSet()
              ).size() == 0
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.reactions is map
              && request.resource.data.reactions.keys().hasOnly(resource.data.participants)
              && request.resource.data.get('reactions', {}).diff(
                resource.data.get('reactions', {})
              ).affectedKeys().hasOnly([request.auth.uid])
              && (
                !request.resource.data.reactions.keys().hasAny([request.auth.uid])
                || request.resource.data.reactions[request.auth.uid] in [
                  '❤️', '😂', '😮', '😢', '🙏', '👍', '🔥', '🎉'
                ]
              )
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              && request.resource.data.readBy is list
              && request.resource.data.readBy.hasOnly(
                get(/databases/$(database)/documents/chats/$(chatId)).data.participants
              )
              && request.resource.data.readBy.toSet().difference(
                resource.data.get('readBy', [resource.data.senderId]).toSet()
              ).hasOnly([request.auth.uid])
              && resource.data.get('readBy', [resource.data.senderId]).toSet().difference(
                request.resource.data.readBy.toSet()
              ).size() == 0
            )
          );
        allow delete: if isChatMember(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /groupInvites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['chatId', 'createdBy', 'createdAt'])
        && request.resource.data.chatId is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        ).data.isGroup == true
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        ).data.groupAdmins
        && getAfter(
          /databases/$(database)/documents/chats/$(request.resource.data.chatId)
        ).data.inviteCode == inviteCode;
      allow delete: if signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(resource.data.chatId)
        ).data.groupAdmins;
      allow update: if false;

      match /joins/{userId} {
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['chatId', 'createdAt'])
          && request.resource.data.chatId == get(
            /databases/$(database)/documents/groupInvites/$(inviteCode)
          ).data.chatId
          && request.resource.data.createdAt == request.time
          && getAfter(
            /databases/$(database)/documents/chats/$(request.resource.data.chatId)
          ).data.isGroup == true
          && getAfter(
            /databases/$(database)/documents/chats/$(request.resource.data.chatId)
          ).data.inviteCode == inviteCode
          && userId in getAfter(
            /databases/$(database)/documents/chats/$(request.resource.data.chatId)
          ).data.participants;
        allow read, delete: if false;
      }
    }
  }
}
